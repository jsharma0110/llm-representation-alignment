venv/
__pycache__/
*.pyc
.DS_Store

cat >> .gitignore <<'EOF'

# Python environments
.venv/
env/

# Generated model representations and outputs
*.pt
*.pth
*.npy
*.npz
*.pkl

# Generated figures
*.png
*.pdf
*.html

# Local caches
.cache/
huggingface/
__pycache__/
.pytest_cache/

# IDE and operating system files
.vscode/
.DS_Store
EOF

cat >> .gitignore <<'EOF'

# Python packaging
*.egg-info/
__pycache__/
*.py[cod]

# Local environments
venv/
.venv/

# macOS
.DS_Store
EOF

cat >> .gitignore <<'EOF'

# Generated experiment outputs
results/**
!results/**/.gitkeep

# Generated figures
figures/**/*.png
figures/**/*.pdf
figures/**/*.html
figures/**/*.pickle
figures/**/*.fig.pickle
EOF